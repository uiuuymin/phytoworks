{
  "name": "@phytoworks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "predev": "pnpm run build",
    "dev": "pnpm run \"/^dev:.*/\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch dist/main.js",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "biome check src test package.json tsconfig.json tsconfig.build.json vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
