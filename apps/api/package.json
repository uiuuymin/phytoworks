{
  "name": "@phytoworks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "predev": "pnpm run build",
    "dev": "pnpm run \"/^dev:.*/\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch dist/main.js",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "vercel-build": "pnpm run prisma:migrate:deploy && pnpm run prisma:seed && pnpm run build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name product-init",
    "prisma:migrate:cart": "prisma migrate dev --name cart-init",
    "prisma:migrate:order": "prisma migrate dev --name order-init",
    "prisma:migrate:payment": "prisma migrate dev --name payment-init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:verify": "node dist/prisma7/verify.js",
    "prisma:seed": "node dist/prisma7/seed.js",
    "prisma:smoke": "node dist/prisma7/spike.js",
    "lint": "biome check src test package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/node": "24.13.3",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@nestjs/testing": "12.0.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "vitest": "4.1.11"
  }
}
